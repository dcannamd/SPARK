// ─────────────────────────────────────────────────────────────────────────────
// SPARK URL ROUTING — Frontend Parameter Capture
//
// Place this in your main frontend JS file (e.g. public/main.js or index.js).
// It reads the URL query string once on load and attaches the active filters
// to every /ask-buddy request automatically.
//
// Example URLs this handles:
//   ?role=lxd
//   ?role=creative-technologist&industry=aerospace
//   ?role=lsa,lxd&industry=saas&category=case-study
// ─────────────────────────────────────────────────────────────────────────────

// ── Step 1: Parse URL params on page load ────────────────────────────────────
const urlParams = new URLSearchParams(window.location.search);

const activeFilters = {
    role:     urlParams.get("role")     || null,   // e.g. "lxd" or "lxd,lsa"
    industry: urlParams.get("industry") || null,   // e.g. "aerospace"
    category: urlParams.get("category") || null    // e.g. "case-study"
};

// Optional: surface active filters visually so the hiring manager
// knows the portfolio is scoped (remove if you want it fully invisible)
if (activeFilters.role || activeFilters.industry || activeFilters.category) {
    console.log("🔗 SPARK routing active:", activeFilters);

    // Example: add a subtle indicator to the page
    // Customize or remove this block entirely for a seamless UX
    const indicator = document.createElement("div");
    indicator.id = "spark-filter-indicator";
    indicator.style.cssText = `
        position: fixed; bottom: 16px; right: 16px;
        background: rgba(0,0,0,0.65); color: #fff;
        font-size: 11px; padding: 6px 10px; border-radius: 6px;
        font-family: monospace; z-index: 9999; pointer-events: none;
    `;
    indicator.textContent = `SPARK lens: ${activeFilters.role || "general"}${activeFilters.industry ? " · " + activeFilters.industry : ""}`;
    document.body.appendChild(indicator);
}

// ── Step 2: Send a message (replace your existing fetch call with this) ───────
async function sendMessage(userPrompt) {
    try {
        const response = await fetch("/ask-buddy", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                prompt:   userPrompt,
                role:     activeFilters.role,       // forwarded from URL → server.js
                industry: activeFilters.industry,   // forwarded from URL → server.js
                category: activeFilters.category    // forwarded from URL → server.js
            })
        });

        const data = await response.json();
        return data.response;

    } catch (error) {
        console.error("❌ sendMessage error:", error);
        return "I'm having trouble connecting right now. Please try again.";
    }
}

// ── Step 3: Reset chat (clears server-side history) ──────────────────────────
async function resetChat() {
    try {
        await fetch("/reset-chat", { method: "POST" });
        console.log("🧹 Chat history cleared.");
    } catch (error) {
        console.error("❌ resetChat error:", error);
    }
}

// ── Step 4: Wire to your UI ───────────────────────────────────────────────────
// Replace the selectors below with whatever IDs your HTML uses.
//
// Minimal expected HTML:
//   <input id="user-input" type="text" placeholder="Ask about Dana's work..." />
//   <button id="send-btn">Send</button>
//   <button id="reset-btn">Clear</button>
//   <div id="chat-output"></div>

document.addEventListener("DOMContentLoaded", () => {
    const input      = document.getElementById("user-input");
    const sendBtn    = document.getElementById("send-btn");
    const resetBtn   = document.getElementById("reset-btn");
    const chatOutput = document.getElementById("chat-output");

    function appendMessage(role, text) {
        const msg = document.createElement("div");
        msg.className = `message ${role}`; // style via CSS: .message.user / .message.spark
        msg.textContent = text;
        chatOutput.appendChild(msg);
        chatOutput.scrollTop = chatOutput.scrollHeight;
    }

    sendBtn?.addEventListener("click", async () => {
        const prompt = input?.value?.trim();
        if (!prompt) return;

        appendMessage("user", prompt);
        input.value = "";

        // Show a loading state while waiting
        const loadingMsg = document.createElement("div");
        loadingMsg.className = "message spark loading";
        loadingMsg.textContent = "SPARK is thinking...";
        chatOutput.appendChild(loadingMsg);

        const reply = await sendMessage(prompt);

        chatOutput.removeChild(loadingMsg);
        appendMessage("spark", reply);
    });

    // Allow Enter key to send
    input?.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            sendBtn?.click();
        }
    });

    resetBtn?.addEventListener("click", async () => {
        await resetChat();
        chatOutput.innerHTML = "";
    });
});
